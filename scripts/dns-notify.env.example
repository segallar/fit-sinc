# Gmail → copy to ~/.config/getsync/dns-notify.env
# chmod 600 ~/.config/getsync/dns-notify.env
#
# Проверка почты: ./scripts/check-getsync-dns.sh --test-smtp
#
# App Password (не обычный пароль Gmail):
#   https://myaccount.google.com/apppasswords
#   (нужна 2FA на аккаунте)

GETSYNC_DNS_NOTIFY_TO=your@gmail.com
GETSYNC_DNS_EXPECTED_IP=134.209.133.187

GETSYNC_DNS_SMTP_HOST=smtp.gmail.com
GETSYNC_DNS_SMTP_PORT=587
GETSYNC_DNS_SMTP_TLS=1
GETSYNC_DNS_SMTP_SSL=0
GETSYNC_DNS_SMTP_USER=your@gmail.com
GETSYNC_DNS_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
GETSYNC_DNS_SMTP_FROM=your@gmail.com
