[Unit]
Description=fit_sinc — Hammerhead to Garmin Connect
After=network.target

[Service]
Type=simple
User=fit_sinc
Group=fit_sinc
WorkingDirectory=/opt/fit_sinc
EnvironmentFile=-/opt/fit_sinc/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/fit_sinc/.cache/ms-playwright
Environment=HOME=/opt/fit_sinc
ExecStart=/opt/fit_sinc/.venv/bin/uvicorn fit_sinc.web.app:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
