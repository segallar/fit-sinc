{
  "name": "fit-sinc-ui",
  "private": true,
  "description": "Tailwind build for fit_sinc web UI v2 (optional, parallel to html.py)",
  "scripts": {
    "build:css": "tailwindcss -i ../fit_sinc/web/static/src/input.css -o ../fit_sinc/web/static/app.css --minify",
    "watch:css": "tailwindcss -i ../fit_sinc/web/static/src/input.css -o ../fit_sinc/web/static/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17"
  }
}
