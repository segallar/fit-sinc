# cp .env.example .env — секреты только в .env, не в git

# Hammerhead OAuth (Developer Portal)
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
HAMMERHEAD_WEBHOOK_SECRET=
# CLI OAuth (getsync hammerhead auth):
HAMMERHEAD_REDIRECT_URI=http://127.0.0.1:8765/callback
# Web OAuth из /app/settings (production):
# HAMMERHEAD_WEB_REDIRECT_URI=https://app.getsync.me/app/settings/hammerhead/callback
HAMMERHEAD_WEB_REDIRECT_URI=
HAMMERHEAD_SCOPE=activity:read

# Шифрование per-user secrets (Settings → Save credentials)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GETSYNC_SECRETS_KEY=

# Данные приложения
DATA_DIR=data

# Сессия веб-кабинета
SESSION_SECRET=change-me-in-production-use-long-random-string
# Production (HTTPS): Secure cookie
SESSION_COOKIE_SECURE=true

# Регистрация и первый admin
REGISTRATION_OPEN=true
# Email → admin при старте (иначе: getsync user promote-admin)
BOOTSTRAP_ADMIN_EMAIL=

# Garmin Connect — только per-user (Settings или getsync garmin login --save-credentials).
# Глобальные GARMIN_EMAIL / GARMIN_PASSWORD в .env не использовать.

# CLI: tenant по умолчанию (локальная разработка)
# DEFAULT_USER_ID=default

# Фоновый refresh Garmin JWT (опционально)
# GARMIN_JWT_REFRESH_INTERVAL_SEC=1800
# GARMIN_JWT_REFRESH_BEFORE_SEC=3600

# Логи (stderr всегда; файл — data/logs/getsync.log)
# LOG_TO_FILE=true
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=5000000
# LOG_BACKUP_COUNT=5

# Почта (Resend) — 2.1e
# MAIL_BACKEND=null
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="GetSync <noreply@getsync.me>"
# MAIL_REPLY_TO=you@example.com
# APP_PUBLIC_URL=https://app.getsync.me
