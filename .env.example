# Hammerhead OAuth
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
HAMMERHEAD_WEBHOOK_SECRET=
HAMMERHEAD_REDIRECT_URI=http://127.0.0.1:8765/callback
# Web OAuth from /app/settings (production):
# HAMMERHEAD_WEB_REDIRECT_URI=https://app.getsync.me/app/settings/hammerhead/callback
HAMMERHEAD_WEB_REDIRECT_URI=
HAMMERHEAD_SCOPE=activity:read

# Garmin Connect (optional — can enter interactively in CLI)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Paths
DATA_DIR=data
DEFAULT_USER_ID=default

# Multi-tenant auth (Phase 5)
SESSION_SECRET=change-me-in-production-use-long-random-string
# HTTPS production (app.getsync.me): Secure cookie, no nginx Basic Auth
SESSION_COOKIE_SECURE=true

# Phase 5b.0 — registration and admin bootstrap
# false = только админ/CLI; true = кнопка Sign up и /register
REGISTRATION_OPEN=true
# Promote this email to admin on startup (optional; else CLI: getsync user promote-admin)
BOOTSTRAP_ADMIN_EMAIL=

# Garmin JWT background refresh (optional)
# GARMIN_JWT_REFRESH_INTERVAL_SEC=1800
# GARMIN_JWT_REFRESH_BEFORE_SEC=3600

# Email (Resend) — 2.1e; ключ только в .env, не в git
# MAIL_BACKEND=null          # null | console | resend
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="GetSync <noreply@getsync.me>"
# MAIL_REPLY_TO=you@example.com
# APP_PUBLIC_URL=https://app.getsync.me
