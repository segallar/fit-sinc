# Hammerhead OAuth
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
HAMMERHEAD_WEBHOOK_SECRET=
HAMMERHEAD_REDIRECT_URI=http://127.0.0.1:8765/callback
# Web OAuth from /app/settings (production):
# HAMMERHEAD_WEB_REDIRECT_URI=https://fit.romansegalla.online/app/settings/hammerhead/callback
HAMMERHEAD_WEB_REDIRECT_URI=
HAMMERHEAD_SCOPE=activity:read

# Garmin Connect (optional — can enter interactively in CLI)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Paths
DATA_DIR=data
DEFAULT_USER_ID=default

# Multi-tenant auth (Phase 5)
SESSION_SECRET=change-me-in-production-use-long-random-string
# HTTPS production (fit.romansegalla.online): Secure cookie, no nginx Basic Auth
SESSION_COOKIE_SECURE=true

# Phase 5b.0 — registration and admin bootstrap
# REGISTRATION_OPEN=false  invite-only; users created by admin or CLI (prod default)
# REGISTRATION_OPEN=true   allow /register when implemented (5b.3)
REGISTRATION_OPEN=false
# Promote this email to admin on startup (optional; else CLI: fit_sinc user promote-admin)
BOOTSTRAP_ADMIN_EMAIL=
