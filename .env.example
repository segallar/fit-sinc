# GetSync — cp .env.example .env
# Секреты только в .env, не в git.

# --- Hammerhead (OAuth приложение, Developer Portal) ---
# Подключение аккаунта пользователя — Settings → Hammerhead; токены в data/users/…/
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
HAMMERHEAD_WEBHOOK_SECRET=
HAMMERHEAD_SCOPE=activity:read
# CLI: getsync hammerhead auth
HAMMERHEAD_REDIRECT_URI=http://127.0.0.1:8765/callback
# Кабинет: /app/settings → Connect (production)
# HAMMERHEAD_WEB_REDIRECT_URI=https://app.getsync.me/app/settings/hammerhead/callback
HAMMERHEAD_WEB_REDIRECT_URI=

# --- Шифрование паролей Garmin на диске (per-user secrets.enc) ---
# Без ключа: сессии Garmin OK, авто-перелогин по сохранённому паролю — нет.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GETSYNC_SECRETS_KEY=

# --- Каталог данных (SQLite, FIT, users/) ---
DATA_DIR=data

# --- Вход в кабинет /app (cookie getsync_session) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-in-production-use-long-random-string
# Локально http://127.0.0.1 — false; production HTTPS — true
SESSION_COOKIE_SECURE=false

# --- Регистрация и первый admin ---
REGISTRATION_OPEN=false
# При старте: email → is_admin (иначе: getsync user promote-admin)
BOOTSTRAP_ADMIN_EMAIL=

# --- Почта (Resend, опционально) ---
MAIL_BACKEND=null
# RESEND_API_KEY=
# MAIL_FROM="GetSync <noreply@getsync.me>"
# MAIL_REPLY_TO=
# APP_PUBLIC_URL=https://app.getsync.me
